{
  "name": "88games",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node tests/spades.test.js",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "smoke": "node scripts/smoke.cjs",
    "format": "prettier --write App.tsx src tests scripts index.js app.json package.json tsconfig.json",
    "format:check": "prettier --check App.tsx src tests scripts index.js app.json package.json tsconfig.json"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~55.0.32",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  }
}
